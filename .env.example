# Copia este archivo a .env y completa los valores. El .env nunca se sube al repo.
# Los secretos están vacíos a propósito: la app no arranca con valores de ejemplo ni con valores débiles.

# Base de datos (MySQL 8)
# Va entre comillas simples porque tiene un "&"; así también funciona con: set -a; source .env; set +a
DB_URL='jdbc:mysql://localhost:3306/equipos_mineros?useSSL=false&allowPublicKeyRetrieval=true'
DB_USER=equipos
# Genera una clave: openssl rand -hex 16
DB_PASSWORD=

# JWT: es obligatorio y tiene que tener 32 caracteres aleatorios como mínimo. Genera uno con: openssl rand -hex 32
JWT_SECRET=
# Duración del token en minutos (por defecto 30)
JWT_EXPIRATION_MINUTES=30

# Usuario administrador inicial (se crea al arrancar si todavía no existe).
# La contraseña tiene que ser aleatoria y de 12 caracteres o más. Genera una con: openssl rand -base64 18
ADMIN_USER=admin
ADMIN_PASSWORD=

# CORS: los orígenes que pueden llamar a la API, separados por coma. URL completa, sin "/" al final y sin "*"
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Puerto HTTP del backend
PORT=8080
