# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.

# Base de datos (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/equipos_mineros?useSSL=false&allowPublicKeyRetrieval=true
DB_USER=equipos
DB_PASSWORD=cambia-esta-clave

# JWT: el secreto debe tener al menos 32 caracteres
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-32-o-mas
JWT_EXPIRATION_MINUTES=60

# Usuario administrador inicial (se crea al arrancar si no existe)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-de-admin

# CORS: orígenes permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Puerto HTTP del backend
PORT=8080
