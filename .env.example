# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.
# Los secretos van VACÍOS a propósito: la aplicación se niega a arrancar con valores de ejemplo o débiles.

# Base de datos (MySQL 8)
# Entre comillas simples porque lleva "&" (así también funciona con: set -a; source .env; set +a)
DB_URL='jdbc:mysql://localhost:3306/equipos_mineros?useSSL=false&allowPublicKeyRetrieval=true'
DB_USER=equipos
# Genera una clave: openssl rand -hex 16
DB_PASSWORD=

# JWT: obligatorio, mínimo 32 caracteres aleatorios. Genera uno: openssl rand -hex 32
JWT_SECRET=
# Duración del token en minutos (por defecto 30)
JWT_EXPIRATION_MINUTES=30

# Usuario administrador inicial (se crea al arrancar si no existe).
# Contraseña de 12+ caracteres aleatorios. Genera una: openssl rand -base64 18
ADMIN_USER=admin
ADMIN_PASSWORD=

# CORS: orígenes permitidos separados por coma (URL completa, sin "/" al final y sin "*")
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Puerto HTTP del backend
PORT=8080
